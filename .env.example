# Credenziale server: mai usare NEXT_PUBLIC_ per questi valori.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Dominio stabile della produzione (non l’URL temporaneo del deployment).
COSMOMEMO_APP_URL=https://cosmo-memo.vercel.app
# Generare due valori casuali diversi, di almeno 32 caratteri.
COSMOMEMO_SESSION_SECRET=replace-with-a-long-random-signing-secret
COSMOMEMO_SETUP_TOKEN=replace-with-a-different-random-activation-code
